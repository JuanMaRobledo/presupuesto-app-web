# Copiá este archivo a .streamlit/secrets.toml para correr la app en tu
# computador (ese archivo NO se sube al repo — está en .gitignore).
#
# Para la versión desplegada en Streamlit Community Cloud, estos mismos
# valores van en Settings -> Secrets de la app (nunca en el repositorio).
#
# Ver en el README la sección "Configurar la conexión a Google Sheets"
# para cómo conseguir cada valor.

sheet_id = "PEGA_ACA_EL_ID_DE_TU_GOOGLE_SHEET"

[gcp_service_account]
type = "service_account"
project_id = "tu-proyecto"
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"
client_email = "presupuesto-app@tu-proyecto.iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "..."
